# Pooled connection string for the Neon branch (development for local work)
DATABASE_URL=
# Neon Auth base URL for the same branch
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Direct (non-pooled) connection string, used only for migrations
DATABASE_URL_UNPOOLED=
# Neon Object Storage for the same branch (neon env pull, or the Neon MCP create_credential
# with storage:read and storage:write). Used for agent avatars in the public-read profile-images bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Base for public object URLs: the branch storage endpoint (same value as AWS_ENDPOINT_URL_S3)
STORAGE_PUBLIC_BASE_URL=
# Signs visitor tokens (jose HS256). Generate with: openssl rand -base64 48
VISITOR_TOKEN_SECRET=
# Real time (apps/realtime). Locally: wrangler dev on 8787. Later: the deployed dev Worker.
REALTIME_URL=http://localhost:8787
NEXT_PUBLIC_REALTIME_HOST=localhost:8787
# Shared with the Worker (apps/realtime/.dev.vars or wrangler secret put). openssl rand -base64 48
REALTIME_TOKEN_SECRET=
REALTIME_PUBLISH_SECRET=
