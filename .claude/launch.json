{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@marshaldesk/web",
        "exec",
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "realtime",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@marshaldesk/realtime", "dev"],
      "port": 8787
    },
    {
      "name": "testhost",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4000",
        "--directory",
        ".claude/testhost"
      ],
      "port": 4000
    }
  ]
}
